{
  "name": "hof-rds-lib",
  "version": "1.0.0",
  "description": "RDS integration library replacing the hof-rds-api sidecar",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "yarn test:lint && yarn test:all",
    "test:all": "yarn test:integration && yarn test:unit",
    "test:integration": "c8 _mocha \"test/_integration/**/*.spec.js\"",
    "test:lint": "eslint .",
    "test:unit": "c8 _mocha \"test/_unit/**/*.spec.js\""
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0 <25.0.0"
  },
  "dependencies": {
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^8.57.1",
    "eslint-config-hof": "^1.3.4",
    "mocha": "^11.7.6",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1"
  },
  "mocha": {
    "reporter": "spec",
    "require": "test/common.js",
    "recursive": "true",
    "timeout": "9000",
    "exit": "true"
  },
  "eslintConfig": {
    "root": true,
    "extends": "./node_modules/eslint-config-hof/default.js",
    "parserOptions": {
      "sourceType": "module"
    },
    "rules": {
      "node/file-extension-in-import": "off"
    },
    "overrides": [
      {
        "files": ["test/**/*.js"],
        "env": { "mocha": true }
      }
    ]
  }
}
