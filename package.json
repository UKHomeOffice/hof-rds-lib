{
  "name": "hof-rds-lib",
  "version": "1.0.0",
  "description": "RDS integration library replacing the hof-rds-api sidecar",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "yarn test:lint && yarn test:all",
    "test:all": "yarn test:integration && yarn test:unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage test/_integration",
    "test:lint": "eslint .",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage test/_unit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.22.2 <25.0.0"
  },
  "dependencies": {
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@aws-sdk/client-rds": "^3.1153.0",
    "eslint": "^8.57.1",
    "eslint-config-hof": "^1.3.4",
    "jest": "^30.2.0",
    "testcontainers": "^12.2.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 9000,
    "coverageDirectory": "coverage"
  },
  "eslintConfig": {
    "root": true,
    "extends": "./node_modules/eslint-config-hof/default.js",
    "parserOptions": {
      "sourceType": "module"
    },
    "rules": {
      "node/file-extension-in-import": "off"
    },
    "overrides": [
      {
        "files": [
          "test/**/*.js"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  }
}
